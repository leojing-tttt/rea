{
  "name": "a3geo-clone-mvp1",
  "version": "0.1.0",
  "private": true,
  "description": "A3GEO MVP-1 clone: search shell, login, mock tasks, read-only rankings",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "test:metrics": "node server/metrics.test.js && node server/monitor-pages.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "echarts": "^5.5.1",
    "element-ui": "^2.15.14",
    "express": "^4.21.2",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "concurrently": "^9.1.2",
    "sass": "^1.83.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
